# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Identity Services web istemci kimligi (public degerdir, secret degildir)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK keys (platforma özel; secret değildir)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Plug & Play Adapter Selectors (Tek satırla sağlayıcı değiştirme: 'mock' | 'iyzico' | 'yurtici')
EXPO_PUBLIC_PAYMENT_PROVIDER=mock
EXPO_PUBLIC_CARRIER_PROVIDER=mock

# Live Credentials (Yalnızca canlıya geçişte doldurulur)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

YURTICI_USER=
YURTICI_PASS=
YURTICI_CUSTOMER_KEY=
YURTICI_API_URL=https://ws.yurticikargo.com
