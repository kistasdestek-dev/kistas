{
  "name": "kistas-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @kistas/web test:e2e",
    "test:live": "node scripts/tests/run-workspace-suite.mjs live",
    "dev:web": "pnpm --filter @kistas/web dev",
    "build:web": "pnpm --filter @kistas/web build",
    "type-check": "turbo run type-check",
    "sayos:security": "pnpm audit --audit-level high && node scripts/security/check-repo-secrets.mjs && node scripts/security/check-xss.mjs && node scripts/security/check-sql-injection.mjs",
    "sayos:audit": "pnpm sayos:security && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "check:system": "node scripts/system-check.mjs",
    "system:check": "node scripts/system-check.mjs",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/create-backup.ps1",
    "tunnel:start": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-tunnel.ps1",
    "tunnel:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev-tunnel.ps1"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  }
}
