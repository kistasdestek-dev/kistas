{
  "name": "kistas-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @kistas/web dev",
    "build:web": "pnpm --filter @kistas/web build",
    "type-check": "turbo run type-check",
    "sayos:security": "pnpm audit --audit-level=high || echo '\\n[!] GÜVENLİK UYARISI (PARS Kalkanı): High/Critical zafiyetler tespit edildi! Ayrıntılar için logları inceleyin.'",
    "sayos:audit": "pnpm sayos:security && pnpm type-check && pnpm build",
    "check:system": "node scripts/system-check.mjs",
    "system:check": "node scripts/system-check.mjs",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/create-backup.ps1",
    "tunnel:start": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-tunnel.ps1",
    "tunnel:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev-tunnel.ps1"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  }
}
