# Bunlar yalnız Supabase Edge Function secret olarak tanımlanır.
# Mobil uygulamanın .env dosyasına veya EXPO_PUBLIC_* alanına koymayın.
REVENUECAT_WEBHOOK_SECRET=generate-a-long-random-secret
REVENUECAT_CREDIT_CURRENCY_CODE=KCR
SHOPIER_OSB_USERNAME=shopier-osb-username-from-panel
SHOPIER_OSB_PASSWORD=shopier-osb-password-from-panel
